{
  "hooks": {
    "before:init": "pnpm --dir ../.. --filter @laststance/tailwindcss-canonical-classes-core build && pnpm --dir ../.. --filter prettier-plugin-tailwindcss-canonical-classes build"
  },
  "git": {
    "changelog": null,
    "tag": true,
    "tagName": "prettier-plugin@${version}",
    "push": true,
    "commit": false
  },
  "github": {
    "release": true,
    "releaseName": "prettier-plugin@${version}",
    "releaseNotes": "git log --no-merges --pretty=format:\"* %s %h\" ${latestTag}...main"
  },
  "npm": {
    "skipChecks": true,
    "publishPackageManager": "pnpm",
    "publishArgs": ["--provenance", "--no-git-checks"]
  }
}
