{
  "hooks": {
    "before:init": "pnpm --dir ../.. build"
  },
  "git": {
    "changelog": null,
    "tag": true,
    "tagName": "cli@${version}",
    "push": true,
    "commit": false
  },
  "github": {
    "release": true,
    "releaseName": "cli@${version}",
    "releaseNotes": "git log --no-merges --pretty=format:\"* %s %h\" ${latestTag}...main"
  },
  "npm": {
    "skipChecks": true,
    "publishArgs": ["--provenance"]
  }
}
